DOMAIN=jobs.example.com

MYSQL_ROOT_PASSWORD=change_this_mysql_root_password
MYSQL_DATABASE=geant_recruitment

JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
RESET_TOKEN_SECRET=change_this_reset_secret
SEED_ON_DEPLOY=false

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=recruitment@jobs.example.com

# Optional (used by docker-compose.prod.yml defaults if omitted)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
